# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=ragfcup
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragfcup
APP_DATABASE_URL=postgresql+asyncpg://ragfcup:changeme@localhost:5432/ragfcup

# ─── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fcup_docs

# ─── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# ─── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
MAGIC_LINK_TTL_MINUTES=15
ALLOWED_EMAIL_DOMAIN=fc.up.pt

# ─── Email (set SIMULATE_EMAIL=true to print link to console) ──────────────────
SIMULATE_EMAIL=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=yourpassword
EMAIL_FROM=noreply@fc.up.pt

# ─── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000
API_URL=http://localhost:8001
